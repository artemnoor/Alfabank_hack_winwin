{
  "name": "alfabank-playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local JSON workbench for Documents.prepare and Runs.query.",
  "engines": {
    "node": "=22.23.3",
    "npm": "=10.9.9"
  },
  "packageManager": "npm@10.9.9",
  "scripts": {
    "contracts:types": "openapi-typescript ../../docs/specs/framework-v1/contracts/openapi.json -o src/api/openapi.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run contracts:types && vite build",
    "dev": "vite"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
